rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Teams collection - Hackathon team roster
    match /teams/{teamNumber} {
      allow read, write: if true;
    }

    // Sessions collection - Attendance sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Attendance collection - Live recorded attendance
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Audit logs collection - Event history
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
